{
  "multipart": [
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "boilingpoint:block/item_pipe/casing/casing" }
    },
    { "when": { "north": "true" }, "apply": { "model": "boilingpoint:block/item_pipe/connection/connection_north" } },
    { "when": { "south": "true" }, "apply": { "model": "boilingpoint:block/item_pipe/connection/connection_south" } },
    { "when": { "east": "true" }, "apply": { "model": "boilingpoint:block/item_pipe/connection/connection_east" } },
    { "when": { "west": "true" }, "apply": { "model": "boilingpoint:block/item_pipe/connection/connection_west" } },
    { "when": { "up": "true" }, "apply": { "model": "boilingpoint:block/item_pipe/connection/connection_up" } },
    { "when": { "down": "true" }, "apply": { "model": "boilingpoint:block/item_pipe/connection/connection_down" } },
    {
      "when": { "OR": [
        { "north": "true", "east": "true" },
        { "north": "true", "west": "true" },
        { "north": "true", "up": "true" },
        { "north": "true", "down": "true" },
        { "south": "true", "east": "true" },
        { "south": "true", "west": "true" },
        { "south": "true", "up": "true" },
        { "south": "true", "down": "true" },
        { "east": "true", "up": "true" },
        { "east": "true", "down": "true" },
        { "west": "true", "up": "true" },
        { "west": "true", "down": "true" }
      ] },
      "apply": { "model": "boilingpoint:block/item_pipe/casing/casing" }
    }
  ]
}
