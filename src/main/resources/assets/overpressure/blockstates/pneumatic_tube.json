{
  "multipart": [
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/core/core_x" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/core/core_y" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/core/core_z" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_north" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_north" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_south" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_south" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_east" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_east" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_west" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_west" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_up" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_up" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_down" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_down" }
    },

    {
      "when": { "OR": [
        { "north": "true", "east": "false", "west": "false", "up": "false", "down": "false" },
        { "south": "true", "east": "false", "west": "false", "up": "false", "down": "false" }
      ] },
      "apply": { "model": "overpressure:block/item_pipe/core/core_x_rotated" }
    },
    {
      "when": { "OR": [
        { "north": "true", "east": "false", "west": "false", "up": "false", "down": "false" },
        { "south": "true", "east": "false", "west": "false", "up": "false", "down": "false" }
      ] },
      "apply": { "model": "overpressure:block/item_pipe/core/core_y" }
    },

    {
      "when": { "OR": [
        { "east": "true", "north": "false", "south": "false", "up": "false", "down": "false" },
        { "west": "true", "north": "false", "south": "false", "up": "false", "down": "false" }
      ] },
      "apply": { "model": "overpressure:block/item_pipe/core/core_y_rotated" }
    },
    {
      "when": { "OR": [
        { "east": "true", "north": "false", "south": "false", "up": "false", "down": "false" },
        { "west": "true", "north": "false", "south": "false", "up": "false", "down": "false" }
      ] },
      "apply": { "model": "overpressure:block/item_pipe/core/core_z_rotated" }
    },

    {
      "when": { "OR": [
        { "up": "true", "north": "false", "south": "false", "east": "false", "west": "false" },
        { "down": "true", "north": "false", "south": "false", "east": "false", "west": "false" }
      ] },
      "apply": { "model": "overpressure:block/item_pipe/core/core_x" }
    },
    {
      "when": { "OR": [
        { "up": "true", "north": "false", "south": "false", "east": "false", "west": "false" },
        { "down": "true", "north": "false", "south": "false", "east": "false", "west": "false" }
      ] },
      "apply": { "model": "overpressure:block/item_pipe/core/core_z" }
    },

    {
      "when": { "OR": [
        { "north": "true", "east": "true" },
        { "north": "true", "west": "true" },
        { "north": "true", "up": "true" },
        { "north": "true", "down": "true" },
        { "south": "true", "east": "true" },
        { "south": "true", "west": "true" },
        { "south": "true", "up": "true" },
        { "south": "true", "down": "true" },
        { "east": "true", "up": "true" },
        { "east": "true", "down": "true" },
        { "west": "true", "up": "true" },
        { "west": "true", "down": "true" }
      ] },
      "apply": { "model": "overpressure:block/item_pipe/casing/casing" }
    },

    { "when": { "north": "true" }, "apply": { "model": "overpressure:block/item_pipe/connection/connection_north" } },
    { "when": { "south": "true" }, "apply": { "model": "overpressure:block/item_pipe/connection/connection_south" } },
    { "when": { "east": "true" }, "apply": { "model": "overpressure:block/item_pipe/connection/connection_east" } },
    { "when": { "west": "true" }, "apply": { "model": "overpressure:block/item_pipe/connection/connection_west" } },
    { "when": { "up": "true" }, "apply": { "model": "overpressure:block/item_pipe/connection/connection_up" } },
    { "when": { "down": "true" }, "apply": { "model": "overpressure:block/item_pipe/connection/connection_down" } },

    {
      "when": { "north": "true", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_south" }
    },
    {
      "when": { "north": "true", "south": "false", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_south" }
    },
    {
      "when": { "north": "false", "south": "true", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_north" }
    },
    {
      "when": { "north": "false", "south": "true", "east": "false", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_north" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "true", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_west" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "true", "west": "false", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_west" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "true", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_east" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "true", "up": "false", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_east" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "true", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_down" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "true", "down": "false" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_down" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "true" },
      "apply": { "model": "overpressure:block/item_pipe/connection/connection_up" }
    },
    {
      "when": { "north": "false", "south": "false", "east": "false", "west": "false", "up": "false", "down": "true" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_up" }
    },

    { "when": { "has_rim": "true", "rim": "north" }, "apply": { "model": "overpressure:block/item_pipe/rim/rim_north" } },
    { "when": { "has_rim": "true", "rim": "south" }, "apply": { "model": "overpressure:block/item_pipe/rim/rim_south" } },
    { "when": { "has_rim": "true", "rim": "east" }, "apply": { "model": "overpressure:block/item_pipe/rim/rim_east" } },
    { "when": { "has_rim": "true", "rim": "west" }, "apply": { "model": "overpressure:block/item_pipe/rim/rim_west" } },
    { "when": { "has_rim": "true", "rim": "up" }, "apply": { "model": "overpressure:block/item_pipe/rim/rim_up" } },
    {
      "when": { "has_rim": "true", "rim": "down" },
      "apply": { "model": "overpressure:block/item_pipe/rim/rim_down" }
    }
  ]
}

